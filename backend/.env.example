# ==============================================================================
# LEGAL HELPER BACKEND - ENVIRONMENT VARIABLES CONFIGURATION (EXAMPLE)
# ==============================================================================
# Copy this file to .env or set these in your Supabase Dashboard:
# Project Settings -> Edge Functions -> Secrets
# ==============================================================================

# Supabase Project Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# AI Provider Configuration ("gemini" | "groq" | "grok")
AI_PROVIDER=gemini

# Google Gemini Configuration (Primary: gemini-1.5-flash / gemini-1.5-pro)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Groq Cloud Configuration (Fast Llama-3.3-70b inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# xAI Grok Configuration (Alternative: Grok API)
GROK_API_KEY=your_xai_grok_key_here
GROK_MODEL=grok-beta

# Security & Rate Limiting
RATE_LIMIT_ENABLED=true
MAX_REQUESTS_PER_MINUTE=30
ALLOWED_ORIGINS=*
